---
import { ui } from '../i18n/ui.js'

interface Props {
  lang: 'es' | 'en'
}

const { lang } = Astro.props
const t = ui[lang].process
---

<section id="proceso" class="py-14 md:py-24 bg-mist border-y border-line">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    <div data-reveal class="grid lg:grid-cols-12 gap-6 lg:gap-10 mb-8 md:mb-12">
      <h2 class="font-display text-4xl md:text-6xl lg:col-span-7">{t.title}</h2>
      <p class="text-muted text-lg leading-relaxed lg:col-span-5 lg:self-end">{t.intro}</p>
    </div>

    <ol data-reveal class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-10 gap-y-10">
      {t.steps.map((step, i) => (
        <li class="border-t-2 border-ink pt-6">
          <span class="font-mono text-[13px] text-fucsia-deep">{i + 1} / {t.steps.length}</span>
          <h3 class="text-2xl font-semibold tracking-tight mt-3 mb-3">{step.title}</h3>
          <p class="text-muted leading-relaxed">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
