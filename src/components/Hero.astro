---
import { ui } from '../i18n/ui.js'
import Molinete from './Molinete.astro'

interface Props {
  lang: 'es' | 'en'
}

const { lang } = Astro.props
const t = ui[lang].hero
---

<section class="p-2.5 md:p-3">
  <div
    class="relative overflow-hidden rounded-[22px] md:rounded-[28px] min-h-[calc(100svh-20px)] md:min-h-[calc(100svh-24px)] flex flex-col justify-end text-white"
    style="background: radial-gradient(120% 90% at 85% 100%, #d946ef 0%, #c026d3 45%, #a21caf 100%);"
  >
    <!-- Puntitos vivos: una ola de brillo los recorre y reaccionan al mouse (ver scripts/hero-dots.js).
         Sin JavaScript queda la textura quieta de CSS. -->
    <div class="dots-texture absolute inset-0 pointer-events-none" data-hero-dots-fallback></div>
    <canvas data-hero-dots aria-hidden="true" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

    <!-- El molinete: gira con el scroll (quieto con "reducir movimiento") -->
    <div
      class="absolute pointer-events-none text-white opacity-[.92]
             w-[72vw] -right-[30vw] top-16
             sm:w-[62vw] sm:-right-[24vw] sm:top-14
             lg:w-[52vw] lg:-right-[14vw] lg:top-1/2 lg:-translate-y-[42%]
             2xl:w-[860px] 2xl:-right-[5vw]"
    >
      <Molinete id="hero-molinete" class="w-full h-auto will-change-transform" />
    </div>

    <div class="relative z-10 max-w-7xl w-full mx-auto px-5 sm:px-8 lg:px-10 pt-36 pb-12 md:pb-16 lg:pb-20">
      <h1 class="font-display text-[2.6rem] leading-[1] sm:text-6xl lg:text-[3.6rem] xl:text-[4rem] 2xl:text-[4.7rem] max-w-[11.5em] [text-wrap:balance]">
        {t.title}
      </h1>
      <p class="mt-7 md:mt-9 text-base md:text-xl text-white/90 max-w-[34rem] leading-relaxed">
        {t.subtitle}
      </p>
      <div class="mt-9 md:mt-11 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a
          href="#contacto"
          class="inline-flex items-center gap-3 bg-white text-ink font-semibold px-7 py-3.5 rounded-full hover:bg-petal transition-colors duration-200 text-[15px]"
        >
          {t.cta}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a
          href="#portfolio"
          class="text-[15px] font-semibold text-white border-b-2 border-white/50 hover:border-white pb-0.5 transition-colors duration-200"
        >
          {t.secondary}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // El molinete gira según cuánto bajaste. Con "reducir movimiento" queda quieto.
  const el = document.getElementById('hero-molinete')
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (el && !quieto) {
    let pendiente = false
    const girar = () => {
      el.style.transform = `rotate(${window.scrollY * 0.12}deg)`
      pendiente = false
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!pendiente) {
          pendiente = true
          requestAnimationFrame(girar)
        }
      },
      { passive: true }
    )
  }
</script>

<script src="../scripts/hero-dots.js"></script>
