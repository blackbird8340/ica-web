---
import { ui, cvFiles } from '../i18n/ui.js'

interface Props {
  lang: 'es' | 'en'
}

const { lang } = Astro.props
const t = ui[lang]
const year = new Date().getFullYear()
---

<footer class="relative">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    <div class="border-t border-white/10 py-8 flex flex-col md:flex-row md:items-center justify-between gap-5">
      <nav class="flex flex-wrap items-center gap-x-7 gap-y-2">
        <span class="font-display text-lg text-white mr-2">ICA</span>
        <a href="#servicios" class="text-[15px] text-gray-300 hover:text-white transition-colors">{t.nav.services}</a>
        <a href="#portfolio" class="text-[15px] text-gray-300 hover:text-white transition-colors">{t.nav.portfolio}</a>
        <a href={cvFiles[lang]} target="_blank" rel="noopener" class="text-[15px] text-gray-300 hover:text-white transition-colors">{t.nav.cv}</a>
        <a href="https://www.linkedin.com/in/imanol-castro-gamero" target="_blank" rel="noopener noreferrer" class="text-[15px] text-gray-300 hover:text-white transition-colors">LinkedIn</a>
      </nav>
      <p class="text-sm text-gray-500">&copy; {year} ICA · {t.footer.rights}</p>
    </div>
  </div>
</footer>
