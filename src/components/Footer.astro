---
import { ui, cvFiles } from '../i18n/ui.js'

interface Props {
  lang: 'es' | 'en'
}

const { lang } = Astro.props
const t = ui[lang]
const year = new Date().getFullYear()
---

<footer class="border-t border-gray-800/30 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <img src="/logo-nuevo.png" alt="ICA" class="h-7" />
        <span class="text-sm font-semibold text-white tracking-wide">ICA</span>
        <span class="text-xs text-gray-500 font-light">&copy; {year} ICA · {t.footer.rights}</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="#servicios" class="text-xs text-gray-500 hover:text-white transition-colors font-light">{t.nav.services}</a>
        <a href="#portfolio" class="text-xs text-gray-500 hover:text-white transition-colors font-light">{t.nav.portfolio}</a>
        <a href={cvFiles[lang]} target="_blank" rel="noopener" class="text-xs text-gray-500 hover:text-white transition-colors font-light">{t.nav.cv}</a>
        <a href="#contacto" class="text-xs text-gray-500 hover:text-white transition-colors font-light">{t.nav.contact}</a>
      </div>
    </div>
  </div>
</footer>
