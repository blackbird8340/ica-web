---
import { ui, cvFiles } from '../i18n/ui.js'
import { featured, more } from '../i18n/projects.js'

interface Props {
  lang: 'es' | 'en'
}

const { lang } = Astro.props
const t = ui[lang].portfolio
const otherLang = lang === 'es' ? 'en' : 'es'

const arrow = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>`
---

<section id="portfolio" class="py-20 md:py-28 border-t border-line">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    <div data-reveal class="grid lg:grid-cols-12 gap-6 lg:gap-10 mb-12 md:mb-16">
      <h2 class="font-display text-4xl md:text-6xl lg:col-span-7">{t.title}</h2>
      <p class="text-muted text-lg leading-relaxed lg:col-span-5 lg:self-end">{t.intro}</p>
    </div>

    <!-- Casos destacados -->
    <div class="space-y-20 md:space-y-28">
      {featured.map((p, i) => {
        const c = p[lang]
        const href = p.link ? p.link[lang] : null
        const flip = i % 2 === 1
        const linkLabel = p.linkType === 'appStore' ? t.appStore : t.visit
        const Frame = href ? 'a' : 'div'
        const frameAttrs = href
          ? { href, target: '_blank', rel: 'noopener noreferrer', 'aria-label': `${p.name}: ${linkLabel}` }
          : {}
        return (
          <article data-reveal class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">
            <figure class:list={['lg:col-span-7', flip && 'lg:order-2']}>
              <div class:list={['relative', p.inset && 'pb-10 sm:pb-12']}>
              <Frame
                {...frameAttrs}
                class="group block relative overflow-hidden rounded-2xl border border-line bg-mist aspect-[16/10]"
                style={p.imageBg ? `background:${p.imageBg}` : undefined}
              >
                <img
                  src={p.image}
                  alt={`${p.name}: ${c.tagline}`}
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    'w-full h-full motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-[1.02]',
                    p.imageFit === 'contain' ? 'object-contain object-center' : 'object-cover object-top',
                  ]}
                />
              </Frame>
              {p.inset && (
                <img
                  src={p.inset.src}
                  alt={`${p.name}: ${p.inset[lang]}`}
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    'absolute bottom-0 w-[44%] sm:w-[38%] aspect-[16/10] object-cover object-top rounded-xl border border-line bg-white shadow-[0_18px_40px_-12px_rgba(26,19,32,.35)]',
                    flip ? 'left-3 lg:left-[-3%]' : 'right-3 lg:right-[-3%]',
                  ]}
                />
              )}
              </div>
              {p.demo && (
                <figcaption class="font-mono text-[11.5px] text-muted mt-3">
                  {t.demo}
                </figcaption>
              )}
            </figure>

            <div class:list={['lg:col-span-5', flip && 'lg:order-1']}>
              <p class="font-mono text-[12.5px] text-muted">{c.kind}</p>
              <h3 class="font-display text-3xl md:text-[2.6rem] mt-3">{p.name}</h3>
              <p class="text-lg md:text-xl font-medium text-fucsia-deep mt-3">{c.tagline}</p>
              <p class="text-muted leading-relaxed mt-5">{c.summary}</p>

              <dl class="grid grid-cols-3 gap-4 border-t border-line mt-8 pt-6">
                {c.metrics.map((m) => (
                  <div class="flex flex-col-reverse justify-end">
                    <dt class="text-[12px] md:text-[13px] text-muted mt-1 leading-snug">{m.label}</dt>
                    <dd class="text-2xl md:text-[1.9rem] font-semibold tracking-tight whitespace-nowrap">{m.value}</dd>
                  </div>
                ))}
              </dl>

              <ul class="flex flex-wrap gap-x-4 gap-y-1 mt-7 font-mono text-[12.5px] text-muted" aria-label={t.stack}>
                {p.stack.map((s) => <li>{s}</li>)}
              </ul>

              <div class="mt-8">
                {href ? (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-[15px] font-semibold text-ink border-b-2 border-ink hover:text-fucsia-deep hover:border-fucsia-deep pb-0.5 transition-colors duration-200"
                  >
                    {linkLabel}
                    <Fragment set:html={arrow} />
                  </a>
                ) : p.status === 'wip' ? (
                  <span class="inline-flex items-center gap-2 text-[13px] font-semibold text-fucsia-deep bg-petal/50 rounded-full px-3 py-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-fucsia" aria-hidden="true"></span>
                    {t.wip}
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-2 text-[13px] text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    {t.private}
                  </span>
                )}
              </div>
            </div>
          </article>
        )
      })}
    </div>

    <!-- Más trabajos -->
    <div data-reveal class="mt-24 md:mt-28">
      <h3 class="text-2xl font-semibold tracking-tight mb-8">{t.moreTitle}</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
        {more.map((p) => {
          const Card = p.link ? 'a' : 'div'
          const attrs = p.link ? { href: p.link, target: '_blank', rel: 'noopener noreferrer' } : {}
          return (
            <Card {...attrs} class="group block">
              <div class="overflow-hidden rounded-xl border border-line bg-mist aspect-[16/10]">
                <img
                  src={p.image}
                  alt={`${p.name}: ${p[lang].kind}`}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover object-top motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.03]"
                />
              </div>
              <div class="flex items-start justify-between gap-4 mt-4">
                <div>
                  <p class="text-lg font-semibold tracking-tight group-hover:text-fucsia-deep transition-colors">{p.name}</p>
                  <p class="font-mono text-[12.5px] text-muted mt-1">{p[lang].kind}</p>
                </div>
                {p.link && (
                  <span class="text-muted group-hover:text-fucsia-deep transition-colors mt-1.5">
                    <Fragment set:html={arrow} />
                  </span>
                )}
              </div>
            </Card>
          )
        })}
      </div>
    </div>

    <!-- CV -->
    <div
      id="cv"
      data-reveal
      class="mt-20 md:mt-24 rounded-2xl bg-mist border border-line p-8 md:p-12 flex flex-col md:flex-row md:items-center justify-between gap-8"
    >
      <div class="max-w-xl">
        <h3 class="font-display text-2xl md:text-4xl">{t.cvTitle}</h3>
        <p class="text-muted mt-4 leading-relaxed">{t.cvText}</p>
      </div>
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 shrink-0">
        <a
          href={cvFiles[lang]}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2.5 bg-ink text-white font-semibold px-6 py-3 rounded-full hover:bg-fucsia-deep transition-colors duration-200 text-[15px]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
          {t.cvPrimary}
        </a>
        <a
          href={cvFiles[otherLang]}
          target="_blank"
          rel="noopener"
          hreflang={otherLang}
          class="text-[15px] font-semibold text-ink border-b-2 border-line hover:border-fucsia-deep hover:text-fucsia-deep pb-0.5 transition-colors duration-200"
        >
          {t.cvSecondary} (PDF)
        </a>
      </div>
    </div>
  </div>
</section>
