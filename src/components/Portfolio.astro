---
import { ui, cvFiles } from '../i18n/ui.js'
import { featured, more } from '../i18n/projects.js'

interface Props {
  lang: 'es' | 'en'
}

const { lang } = Astro.props
const t = ui[lang].portfolio
const otherLang = lang === 'es' ? 'en' : 'es'

const arrow = `<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>`
---

<section id="portfolio" class="py-32 relative">
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div data-reveal class="mb-20 md:mb-28">
      <p class="text-xs text-gray-500 tracking-widest uppercase mb-4">{t.label}</p>
      <h2 class="text-3xl md:text-5xl font-medium text-white tracking-tight">
        {t.title1} <span class="font-serif italic font-normal">{t.title2}</span>
      </h2>
      <p class="text-gray-400 font-light mt-4 max-w-2xl">{t.intro}</p>
    </div>

    <!-- Casos destacados -->
    <div class="space-y-24 md:space-y-36">
      {featured.map((p, i) => {
        const c = p[lang]
        const href = p.link ? p.link[lang] : null
        const flip = i % 2 === 1
        const linkLabel = p.linkType === 'appStore' ? t.appStore : t.visit
        const Frame = href ? 'a' : 'div'
        const frameAttrs = href
          ? { href, target: '_blank', rel: 'noopener noreferrer', 'aria-label': `${p.name} — ${linkLabel}` }
          : {}
        return (
          <article data-reveal class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
            <Frame
              {...frameAttrs}
              class:list={[
                'group block relative overflow-hidden rounded-2xl border border-gray-800/70 aspect-[16/10] lg:col-span-7',
                flip && 'lg:order-2',
              ]}
              style={p.imageBg ? `background:${p.imageBg}` : undefined}
            >
              <img
                src={p.image}
                alt={`${p.name} — ${c.tagline}`}
                loading="lazy"
                decoding="async"
                class:list={[
                  'w-full h-full motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-[1.02]',
                  p.imageFit === 'contain' ? 'object-contain object-center' : 'object-cover object-top',
                ]}
              />
            </Frame>

            <div class:list={['lg:col-span-5', flip && 'lg:order-1']}>
              <div class="flex items-baseline gap-4 mb-5">
                <span class="text-violet-500 text-sm font-medium tracking-wide">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-[11px] text-gray-500 tracking-widest uppercase">{c.kind}</span>
              </div>

              <h3 class="text-3xl md:text-4xl font-medium text-white tracking-tight">{p.name}</h3>
              <p class="font-serif italic text-xl md:text-2xl text-gray-300 mt-2">{c.tagline}</p>
              <p class="text-gray-400 font-light text-[15px] leading-relaxed mt-6">{c.summary}</p>

              <dl class="grid grid-cols-3 gap-4 border-t border-gray-800/70 mt-8 pt-6">
                {c.metrics.map((m) => (
                  <div>
                    <dt class="sr-only">{m.label}</dt>
                    <dd class="text-2xl md:text-3xl font-light text-white tracking-tight whitespace-nowrap">{m.value}</dd>
                    <dd class="text-[11px] md:text-xs text-gray-500 font-light mt-1 leading-snug">{m.label}</dd>
                  </div>
                ))}
              </dl>

              <ul class="flex flex-wrap gap-2 mt-8" aria-label={t.stack}>
                {p.stack.map((s) => (
                  <li class="text-[11px] text-gray-400 border border-gray-800 rounded-full px-3 py-1 font-light">{s}</li>
                ))}
              </ul>

              <div class="mt-8">
                {href ? (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-2 text-sm text-white font-medium border-b border-white/50 hover:border-violet-400 hover:text-violet-400 pb-1 transition-colors duration-200"
                  >
                    {linkLabel}
                    <Fragment set:html={arrow} />
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-2 text-xs text-gray-500 font-light">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    {t.private}
                  </span>
                )}
              </div>
            </div>
          </article>
        )
      })}
    </div>

    <!-- Más trabajos -->
    <div data-reveal class="mt-32">
      <p class="text-xs text-gray-500 tracking-widest uppercase mb-8">{t.moreTitle}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {more.map((p) => {
          const Card = p.link ? 'a' : 'div'
          const attrs = p.link ? { href: p.link, target: '_blank', rel: 'noopener noreferrer' } : {}
          return (
            <Card {...attrs} class="group block">
              <div class="relative overflow-hidden rounded-xl border border-gray-800/70 bg-black-800 aspect-[16/10]">
                <img
                  src={p.image}
                  alt={`${p.name} — ${p[lang].kind}`}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover object-top motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.03]"
                />
              </div>
              <div class="flex items-start justify-between gap-4 mt-4">
                <div>
                  <h3 class="text-base font-medium text-white group-hover:text-violet-400 transition-colors">{p.name}</h3>
                  <p class="text-xs text-gray-500 font-light mt-1">{p[lang].kind}</p>
                </div>
                {p.link && (
                  <span class="text-gray-500 group-hover:text-violet-400 transition-colors mt-1">
                    <Fragment set:html={arrow} />
                  </span>
                )}
              </div>
            </Card>
          )
        })}
      </div>
    </div>

    <!-- CV -->
    <div
      id="cv"
      data-reveal
      class="mt-32 rounded-2xl border border-gray-800/70 bg-black-900 p-8 md:p-12 flex flex-col md:flex-row md:items-center justify-between gap-8"
    >
      <div class="max-w-xl">
        <h3 class="text-2xl md:text-3xl font-medium text-white tracking-tight">
          {t.cvTitle1} <span class="font-serif italic font-normal">{t.cvTitle2}</span>
        </h3>
        <p class="text-gray-400 font-light mt-3 leading-relaxed">{t.cvText}</p>
      </div>
      <div class="flex flex-col sm:flex-row md:flex-col lg:flex-row items-start sm:items-center md:items-end lg:items-center gap-5 shrink-0">
        <a
          href={cvFiles[lang]}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-3 bg-violet-500 text-white font-medium px-6 py-3 rounded-full hover:bg-violet-400 transition-colors duration-200 text-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
          {t.cvPrimary}
        </a>
        <a
          href={cvFiles[otherLang]}
          target="_blank"
          rel="noopener"
          hreflang={otherLang}
          class="text-sm text-gray-400 hover:text-white border-b border-gray-700 hover:border-violet-400 pb-0.5 transition-colors duration-200"
        >
          {t.cvSecondary} (PDF)
        </a>
      </div>
    </div>
  </div>
</section>
