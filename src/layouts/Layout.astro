---
import { ui, paths } from '../i18n/ui.js'

interface Props {
  lang?: 'es' | 'en'
}

const { lang = 'es' } = Astro.props
const m = ui[lang].meta
const site = 'https://icaweb.dev'
const canonical = site + paths[lang]
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Primary -->
    <title>{m.title}</title>
    <meta name="description" content={m.description} />
    <meta name="keywords" content={m.keywords} />
    <meta name="author" content="Imanol Castro - ICA" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={site + paths.es} />
    <link rel="alternate" hreflang="en" href={site + paths.en} />
    <link rel="alternate" hreflang="x-default" href={site + paths.es} />

    <!-- Favicon -->
    <link rel="icon" href="/logo-nuevo.png" />
    <link rel="apple-touch-icon" href="/logo-nuevo.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={m.title} />
    <meta property="og:description" content={m.description} />
    <meta property="og:image" content="https://icaweb.dev/logo-nuevo.png" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={m.ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'es' ? ui.en.meta.ogLocale : ui.es.meta.ogLocale} />
    <meta property="og:site_name" content="ICA" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={m.title} />
    <meta name="twitter:description" content={m.description} />
    <meta name="twitter:image" content="https://icaweb.dev/logo-nuevo.png" />

    <!-- Geo Tags (SEO local) -->
    <meta name="geo.region" content="AR-CF" />
    <meta name="geo.placename" content="Buenos Aires, Argentina" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "ICA - Imanol Castro",
      "description": m.description,
      "inLanguage": lang,
      "url": canonical,
      "logo": "https://icaweb.dev/logo-nuevo.png",
      "image": "https://icaweb.dev/logo-nuevo.png",
      "telephone": "+542942553671",
      "email": "contacto@icaweb.dev",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Capital Federal",
        "addressRegion": "Buenos Aires",
        "addressCountry": "AR"
      },
      "areaServed": {
        "@type": "Country",
        "name": "Argentina"
      },
      "founder": {
        "@type": "Person",
        "name": "Imanol Castro",
        "jobTitle": lang === 'es' ? "Desarrollador Full-Stack" : "Full-Stack Developer",
        "sameAs": ["https://www.linkedin.com/in/imanol-castro-gamero"]
      },
      "serviceType": ["Desarrollo Web", "Landing Pages", "Sistemas a Medida", "Mantenimiento Web"],
      "priceRange": "$$"
    })} />

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Q8L6EG0YV3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Q8L6EG0YV3');
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Sora:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-black-950">
    <slot />
    <script src="../scripts/scroll-reveal.js"></script>
  </body>
</html>
